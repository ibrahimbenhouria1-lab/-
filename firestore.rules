rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 0. GLOBAL SAFETY NET
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 1. GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Relational Admin Check (Cached in user doc)
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; 
    }
    
    function isTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // -------------------------------------------------------------------------
    // 2. USERS COLLECTION
    // -------------------------------------------------------------------------
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['name', 'role', 'status']) &&
               data.role is string && data.role in ['admin', 'teacher', 'parent'] &&
               data.status is string && data.status in ['active', 'inactive'] &&
               data.name is string && data.name.size() <= 100;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
    }

    // -------------------------------------------------------------------------
    // 3. ACCESS CODES (The Gateway)
    // -------------------------------------------------------------------------
    match /access_codes/{code} {
      allow get: if isSignedIn(); // Needed for verification during login
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 4. STUDENTS
    // -------------------------------------------------------------------------
    match /students/{studentId} {
      function isValidStudent(data) {
        return data.keys().hasAll(['name', 'points']) &&
               data.name is string && data.name.size() <= 100 &&
               data.points is number;
      }

      allow read: if isSignedIn();
      allow create: if (isAdmin() || isTeacher()) && isValidStudent(incoming());
      allow update: if (isAdmin() || isTeacher()) && isValidStudent(incoming());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 5. CLASSES
    // -------------------------------------------------------------------------
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    // -------------------------------------------------------------------------
    // 6. ATTENDANCE & BEHAVIOR
    // -------------------------------------------------------------------------
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || isTeacher());
      allow update, delete: if isAdmin();
    }

    match /behavior/{recordId} {
      allow read: if isSignedIn();
      allow create: if (isAdmin() || isTeacher());
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 7. SYSTEM COLLECTIONS (Announcements, Homework)
    // -------------------------------------------------------------------------
    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /homework/{hwId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }
  }
}
